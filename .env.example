# Application
APP_NAME=NutrientrenaAPI
DEBUG=false

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=nutrientrena

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudflare R2 (compatible con S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=nutrientrena-files

# CORS — orígenes permitidos para la API
# En producción poner la URL exacta del frontend (sin / al final).
# Si se omite, usa FRONTEND_URL automáticamente cuando no es localhost.
# Para dev local dejar en blanco (equivale a "*").
ALLOWED_ORIGINS=https://tudominio.up.railway.app

# Email (Resend)
RESEND_API_KEY=re_...
MAIL_FROM=onboarding@resend.dev
FRONTEND_URL=https://tudominio.up.railway.app
AWS_ENDPOINT_URL=https://77925e3b1a6f6513bce155f71f6aa790.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-397ed3b6f1d1480d8c17d960513a3c78.r2.dev

USDA_API_KEY= RStkwim5gGyPuzmPAY02fjBcAeejLNafRnlHedU7 
DEEPL_API_KEY=b5f8eb8c-9482-498b-aa6a-d599a065cc1a:fx

# Generación de dietas con IA (opcional). Sin esta clave el botón
# "Generar con IA" avisa de que la función no está configurada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Generar la dieta entera con IA: se paga por dieta y manda datos del cliente
# (patologías, peso) a la API. Apagado a propósito.
AI_DIET_ENABLED=false

# Clasificar alimentos por momento del día (desayuno / snack / comida-cena).
# Es lo que evita que el generador proponga ternera al desayuno. Se paga una
# vez por alimento, no una por dieta, y en el prompt solo viajan nombres de
# alimentos y macros: ningún dato de ningún cliente sale de aquí.
AI_CLASSIFY_ENABLED=true
# "anthropic" o "groq". Groq tiene tier gratuito y sirve para probar que
# funciona antes de decidir el gasto; se cambia sin tocar código.
AI_CLASSIFY_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_CLASSIFY_MODEL=llama-3.3-70b-versatile
# Solo si AI_CLASSIFY_PROVIDER=anthropic
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5
